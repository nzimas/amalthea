/*
 * resurgent's patch-wide parameters, in table order, with their defaults:
 * the elements of a Surge patch that belong to neither scene -- the scene
 * mode, the master volume and the effect slots. Read as ResurgentParams.def
 * is, by the core and by the Swift reader. Appended to, never reordered.
 */
